# Copy to .env. Keys are read from the standard provider variables.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SLACK_BOT_TOKEN=

# auto picks anthropic, then gemini, then the offline heuristic, based on which keys exist.
COS_BACKEND=auto
COS_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
COS_ANTHROPIC_ESCALATION_MODEL=claude-sonnet-5
COS_GEMINI_MODEL=gemini-3.5-flash-lite

# Match these to your provider tier; the rate limiter enforces them client-side.
COS_ANTHROPIC_RPM=50
COS_GEMINI_RPM=15
COS_MAX_CONCURRENCY=8

COS_REDACT_PII=true
COS_DATE_ORDER=DMY

# USD per million tokens as [input, output]; used for cost reporting only.
# COS_PRICES_PER_MTOK={"claude-haiku-4-5-20251001": [1.0, 5.0]}
